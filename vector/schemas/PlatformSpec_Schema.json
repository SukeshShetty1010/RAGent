{
  "class": "PlatformSpec",
  "description": "Platform-specific operational data for a game. Used strictly for filtering and constraints, not semantic search.",
  "vectorizer": "none",

  "properties": [
    {
      "name": "platform_name",
      "dataType": ["text"],
      "description": "Platform name (e.g. PC, PS5, Xbox Series X)",
      "indexFilterable": true,
      "indexSearchable": false,
      "moduleConfig": {
        "text2vec-transformers": {
          "skip": true
        }
      }
    },
    {
      "name": "platform_family",
      "dataType": ["text"],
      "description": "Platform family grouping (PC, PlayStation, Xbox)",
      "indexFilterable": true,
      "indexSearchable": false,
      "moduleConfig": {
        "text2vec-transformers": {
          "skip": true
        }
      }
    },
    {
      "name": "release_date",
      "dataType": ["date"],
      "description": "Platform-specific release date",
      "indexFilterable": true,
      "indexSearchable": false,
      "moduleConfig": {
        "text2vec-transformers": {
          "skip": true
        }
      }
    },
    {
      "name": "requirements_minimum",
      "dataType": ["text"],
      "description": "Minimum system requirements",
      "indexFilterable": false,
      "indexSearchable": false,
      "moduleConfig": {
        "text2vec-transformers": {
          "skip": true
        }
      }
    },
    {
      "name": "requirements_recommended",
      "dataType": ["text"],
      "description": "Recommended system requirements",
      "indexFilterable": false,
      "indexSearchable": false,
      "moduleConfig": {
        "text2vec-transformers": {
          "skip": true
        }
      }
    },
    {
      "name": "game",
      "dataType": ["Game"],
      "description": "Canonical Game entity this platform specification belongs to"
    }
  ]
}
