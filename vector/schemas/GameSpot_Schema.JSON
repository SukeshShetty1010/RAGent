{
  "class": "GameSpot_Game",
  "description": "GameSpot editorial container storing raw summaries, reviews, and articles. Feeds downstream chunking and semantic indexing.",
  "vectorizer": "none",

  "properties": [
    {
      "name": "game",
      "dataType": ["Game"],
      "description": "Canonical Game this editorial content belongs to"
    },

    {
      "name": "metadata",
      "dataType": ["object"],
      "description": "Core GameSpot metadata (non-semantic)",
      "indexFilterable": false,
      "indexSearchable": false,
      "nestedProperties": [
        {
          "name": "gamespot_id",
          "dataType": ["int"],
          "description": "GameSpot game ID",
          "indexFilterable": true
        },
        {
          "name": "name",
          "dataType": ["text"],
          "description": "Game name",
          "indexFilterable": true
        },
        {
          "name": "slug",
          "dataType": ["text"],
          "description": "Game slug",
          "indexFilterable": true
        },
        {
          "name": "release_date",
          "dataType": ["date"],
          "description": "Release date",
          "indexFilterable": true
        }
      ]
    },

    {
      "name": "summary",
      "dataType": ["object"],
      "description": "Editorial summaries (raw, not embedded)",
      "indexFilterable": false,
      "indexSearchable": false,
      "nestedProperties": [
        {
          "name": "deck",
          "dataType": ["text"],
          "description": "Short editorial summary"
        },
        {
          "name": "description",
          "dataType": ["text"],
          "description": "Full editorial description"
        }
      ]
    },

    {
      "name": "reviews",
      "dataType": ["object"],
      "description": "Review metadata and review content",
      "indexFilterable": false,
      "indexSearchable": false,
      "nestedProperties": [
        {
          "name": "average_score",
          "dataType": ["number"],
          "description": "Average review score",
          "indexFilterable": true
        },
        {
          "name": "items",
          "dataType": ["object[]"],
          "description": "Individual reviews",
          "nestedProperties": [
            {
              "name": "title",
              "dataType": ["text"],
              "description": "Review title"
            },
            {
              "name": "score",
              "dataType": ["number"],
              "description": "Review score",
              "indexFilterable": true
            },
            {
              "name": "date",
              "dataType": ["date"],
              "description": "Review date",
              "indexFilterable": true
            },
            {
              "name": "body",
              "dataType": ["text"],
              "description": "Full review body"
            }
          ]
        }
      ]
    },

    {
      "name": "articles",
      "dataType": ["object[]"],
      "description": "Editorial articles",
      "indexFilterable": false,
      "indexSearchable": false,
      "nestedProperties": [
        {
          "name": "title",
          "dataType": ["text"],
          "description": "Article title"
        },
        {
          "name": "date",
          "dataType": ["date"],
          "description": "Article publish date",
          "indexFilterable": true
        },
        {
          "name": "deck",
          "dataType": ["text"],
          "description": "Article summary deck"
        },
        {
          "name": "body",
          "dataType": ["text"],
          "description": "Full article body"
        }
      ]
    }
  ]
}
