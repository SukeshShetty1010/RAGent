# ============================================================
# RAGent — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.
# ============================================================

# ---------- Vector Database (Qdrant Cloud) ----------
QDRANT_URL=
QDRANT_API_KEY=

# ---------- LLM (Groq) ----------
GROQ_API_KEY=

# ---------- Web Search Fallback (Tavily) ----------
TAVILY_API_KEY=

# ---------- Data Ingestion Sources ----------
GAMESPOT_API_KEY=
RAWG_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------- Modal (embeddings, reranking, optional LLM) ----------
# Required for `modal deploy` and any code path that resolves Modal
# services (retriever/rag_retriever.py) at runtime.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
