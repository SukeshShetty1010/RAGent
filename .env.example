# ============================================================
# RAGent — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.
# ============================================================

# ---------- Vector Database (Qdrant Cloud) ----------
QDRANT_URL=
QDRANT_API_KEY=

# ---------- LLM (Gemini primary, Groq fallback) ----------
GEMINI_API_KEY=
GROQ_API_KEY=

# Both models are overridable because both providers have already
# retired one out from under this project. Leave unset to use the
# defaults in llm/gemini_client.py and llm/ragent_client.py.
#
# GEMINI_MODEL defaults to "gemini-flash-lite-latest". Set this to
# "gemini-flash-latest" for a stronger model, but note that alias
# currently resolves to gemini-3.7-flash: 20 requests/day on the free
# tier, and observed closing long response streams mid-answer.
# GEMINI_MODEL=
#
# GEMINI_REASONING_EFFORT suppresses the thinking budget. Default "none";
# set to "" to stop sending the parameter at all. Lite models reject
# "none" with a bare 400 and accept "low" — the client detects that and
# retries without the parameter, so this rarely needs setting by hand.
# GEMINI_REASONING_EFFORT=
#
# GROQ_MODEL default "openai/gpt-oss-120b". Note it is a reasoning model:
# hidden reasoning tokens count against max_tokens, and Groq rejects
# reasoning_effort="none". A model with a different shape may need the
# token budgets in llm/ragent_client.py revisited.
# GROQ_MODEL=

# ---------- Reranker ----------
# RERANKER_PROVIDER: "local" (in-process fastembed cross-encoder, default),
# "cloudflare" (Workers AI bge-reranker-base), "hfspace" (same model as
# local, on an HF Docker Space — needs HF PRO since July 2026), or
# "voyage" (Voyage rerank API). Only "hfspace" shares local's calibrated
# relevance floors; the others are different models on different score
# scales, so retriever/quality_gate.py keeps per-provider floors.
RERANKER_PROVIDER=local

# Required when RERANKER_PROVIDER=cloudflare. Workers AI free tier is
# 10,000 Neurons/day with no payment method on file. The API token needs
# the "Workers AI: Read" permission; the account ID is on the Cloudflare
# dashboard sidebar.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Required when RERANKER_PROVIDER=hfspace.
# Base URL of the Space, no trailing slash, e.g.
# https://your-name-ragent-reranker.hf.space
HF_RERANK_URL=
# Shared secret matching the Space's RERANK_SECRET (optional but advised).
HF_RERANK_SECRET=
# HF access token — only needed if the Space is private.
HF_TOKEN=

# Required when RERANKER_PROVIDER=voyage.
VOYAGE_API_KEY=

# ---------- Corpus entity index ----------
# How often retriever/corpus_index.py's in-process entity index (the
# set of Game titles used for grounding checks) is refreshed from
# Qdrant, in seconds. Default 900 (15 min). Set to 0 to disable
# refresh entirely — evaluation/calibrate_relevance.py wants this, so
# the entity index can't change mid-run and skew group assignment.
CORPUS_INDEX_TTL_SECONDS=900

# ---------- Web Search Fallback (Tavily) ----------
TAVILY_API_KEY=

# ---------- Data Ingestion Sources ----------
GAMESPOT_API_KEY=
RAWG_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------- Tracing (Langfuse, optional) ----------
# Both keys must be set for tracing to activate — utils/tracing.py is a
# hard no-op otherwise (no import, no client, zero overhead).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
