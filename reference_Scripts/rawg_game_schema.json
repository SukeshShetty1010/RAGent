{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/rawg_game.schema.json",
    "title": "RAWG Game Canonical Object",
    "description": "Schema validating the canonical Game object produced from RAWG data",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "game_id": {
        "type": "integer",
        "description": "RAWG game ID"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "Game title"
      },
      "description": {
        "type": ["string", "null"],
        "description": "Long-form game description"
      },
      "release_date": {
        "type": ["string", "null"],
        "format": "date",
        "description": "Official release date (ISO 8601)"
      },
      "release_year": {
        "type": ["integer", "null"],
        "description": "Release year for fast filtering"
      },
      "genres": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Game genres"
      },
      "developers": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Game developers"
      },
      "publishers": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Game publishers"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Community and gameplay tags"
      },
      "average_rating": {
        "type": ["number", "null"],
        "description": "Average RAWG rating"
      },
      "metacritic_score": {
        "type": ["integer", "null"],
        "description": "Metacritic score"
      },
      "source_rawg_url": {
        "type": ["string", "null"],
        "description": "Official website or RAWG source URL"
      },
      "last_updated": {
        "type": ["string", "null"],
        "format": "date",
        "description": "Last updated timestamp from source"
      },
      "has_platform_specs": {
        "type": "boolean",
        "description": "Whether platform specs exist"
      }
    },
    "required": ["game_id", "title"]
  }
  