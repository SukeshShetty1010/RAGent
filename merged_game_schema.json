{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "merged_game_schema",
  "type": "object",
  "description": "JSON Schema for the merged game object (matches GameMerged Pydantic model).",
  "properties": {
    "unified_id": { "type": ["string", "null"] },
    "title": { "type": "string" },
    "slug": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "release_date": { "type": ["string", "null"], "format": "date" },
    "release_year": { "type": ["integer", "null"] },
    "release_dates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": { "type": ["string", "null"] }
      }
    },
    "rawg_id": { "type": ["integer", "null"] },
    "igdb_id": { "type": ["integer", "null"] },
    "gamespot_id": { "type": ["string", "null"] },
    "platforms": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "genres": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "themes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "developers": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "publishers": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "age_ratings": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "esrb_rating": { "type": ["string", "null"] },
    "ratings": {
      "type": "object",
      "properties": {
        "rawg": { "type": ["number", "null"] },
        "igdb": { "type": ["number", "null"] },
        "metacritic": { "type": ["integer", "null"] },
        "rawg_detail": {
          "oneOf": [
            { "type": "object" },
            { "type": "array" },
            { "type": "null" }
          ]
        },
        "igdb_detail": {
          "oneOf": [
            { "type": "object" },
            { "type": "array" },
            { "type": "null" }
          ]
        },
        "normalized_0_100": { "type": ["integer", "null"] }
      },
      "additionalProperties": true,
      "default": {}
    },
    "urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "default": []
    },
    "stores": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "websites": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "default": []
    },
    "gamespot": {
      "type": "object",
      "description": "Raw / processed GameSpot block (free-form)",
      "additionalProperties": true,
      "default": {}
    },
    "documents": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true },
      "default": []
    },
    "source": {
      "type": "object",
      "properties": {
        "rawg": { "type": ["object", "null"], "additionalProperties": true },
        "igdb": { "type": ["object", "null"], "additionalProperties": true },
        "gamespot": { "type": ["object", "null"], "additionalProperties": true }
      },
      "additionalProperties": true,
      "default": {}
    },
    "merged_from": {
      "oneOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    }
  },
  "required": ["title"],
  "additionalProperties": true
}
